{
  "name": "oceaniq-root",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "npm --prefix frontend run dev",
    "build": "npm --prefix frontend run build",
    "install:frontend": "npm --prefix frontend install",
    "backend": "python -m uvicorn backend.app.main:app --host 0.0.0.0 --port 8000 --reload --reload-dir backend",
    "start:all": "start cmd /k \"npm run backend\" && npm run dev"
  }
}
